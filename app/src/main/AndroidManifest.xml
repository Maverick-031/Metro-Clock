<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Exact alarm permission for qualifying alarm clock applications.

        If MetroClock does not qualify for USE_EXACT_ALARM under Google Play
        policy, replace this with SCHEDULE_EXACT_ALARM and implement the
        special-access request flow.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Notifications on Android 13 and newer. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Alarm and timer full-screen notifications. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Alarm and timer behavior. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Timer and stopwatch foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Restore enabled alarms after device restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Optional calendar-based Smart Skip. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Optional location-based Smart Skip. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Wi-Fi-based Smart Skip. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ClockApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!--
            Main user interface.

            singleTop allows an existing MainActivity instance to receive alarm
            and timer Intents through onNewIntent().
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.MyApplication">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Receives internal explicit alarm trigger, snooze, and dismiss
            PendingIntents.

            AlarmScheduler and notification actions use explicit Intents, so
            this receiver does not need to be exported or have an intent filter.
        -->
        <receiver
            android:name=".receiver.AlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
            Restores enabled alarms after a device reboot.

            This receiver must remain exported because the Android system sends
            the boot broadcasts.
        -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />

                <!-- Supported by some device manufacturers. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>

        </receiver>

        <!--
            Runs user-started countdown timer and stopwatch operations.

            The service is private and accepts explicit commands only from
            MetroClock.
        -->
        <service
            android:name=".service.TimerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started countdown timer and stopwatch execution" />

        </service>

    </application>

</manifest>
